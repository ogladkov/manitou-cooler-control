@@ -0,0 +1,53 @@
+use cc_image::{LcdImageGenerator, SENSOR_STYLES};
+
+fn main() -> anyhow::Result<()> {
+    let output = std::env::args().nth(1).expect("output directory");
+    std::fs::create_dir_all(&output)?;
+    let generator = LcdImageGenerator::new();
+    let mut history: Vec<_> = (0..60).map(|i| 48.0 + i as f64 * 0.28 + (i as f64 * 0.3).sin()*7.0).collect();
+    history[59] = 67.4;
+    let mut gpu_history: Vec<_> = (0..60).map(|i| 30.0 + i as f64 * 0.2 + (i as f64 * 0.23).cos()*8.0).collect();
+    gpu_history[59] = 42.8;
+    for style in SENSOR_STYLES {
+        let (png, _) = generator.generate_sensor_image(67.4, "CPU PACKAGE", style, &history, None)?;
+        std::fs::write(std::path::Path::new(&output).join(format!("{style}.png")), png)?;
+    }
+    let (critical, _) = generator.generate_metric_image_with_thresholds(85.0, "CPU LOAD", "mono_reverse",
+        &history, None, cc_image::SensorUnit::Percent, &[(85.0, (255,0,0))])?;
+    std::fs::write(std::path::Path::new(&output).join("mono_reverse_critical.png"), critical)?;
+    for style in cc_image::PANORAMA_STYLES {
+        let panel = || cc_image::PanoramaPanel { value: 67.4, label: "CPU LOAD", style,
+            history: &history, unit: cc_image::SensorUnit::Percent, thresholds: &[] };
+        for (suffix, right) in [("", None), ("_split", Some(cc_image::PanoramaPanel {
+            value: 42.8, label: "GPU LOAD", history: &gpu_history, ..panel()
+        }))] {
+            let (png, _) = generator.generate_panorama_image(panel(), right)?;
+            if suffix == "_split" {
+                image::load_from_memory(&png)?.crop_imm(0, 0, 1120, 1080)
+                    .save(std::path::Path::new(&output).join(format!("{style}_panel.png")))?;
+            }
+            std::fs::write(std::path::Path::new(&output).join(format!("{style}{suffix}.png")), png)?;
+        }
+    }
+    for style in cc_image::PANORAMA_STYLES {
+        let cells: Vec<_> = (0..8).map(|_| cc_image::PanoramaPanel {
+            value: 67.4, label: "CPU LOAD", style, history: &history,
+            unit: cc_image::SensorUnit::Percent, thresholds: &[],
+        }).collect();
+        let (png, _) = generator.generate_panorama_grid_image(&cells)?;
+        image::load_from_memory(&png)?.crop_imm(0, 0, 560, 540)
+            .save(std::path::Path::new(&output).join(format!("{style}_cell.png")))?;
+    }
+    let labels = ["CPU LOAD", "GPU LOAD", "RAM LOAD", "VRAM LOAD", "CPU TEMP", "GPU TEMP", "FAN SPEED", "WEEKLY LIMIT"];
+    let values = [67.4, 42.8, 55.2, 72.0, 58.0, 64.0, 1250.0, 82.0];
+    let cell_histories: Vec<Vec<_>> = values.iter().map(|value| (0..60).map(|i|
+        value * (0.85 + 0.15 * (i as f64 * 0.14).sin())).collect()).collect();
+    let cells: Vec<_> = (0..8).map(|i| cc_image::PanoramaPanel {
+        value: values[i], label: labels[i], style: "panorama_scope", history: &cell_histories[i],
+        unit: if i == 6 { cc_image::SensorUnit::Rpm } else if i == 4 || i == 5 { cc_image::SensorUnit::Celsius } else { cc_image::SensorUnit::Percent },
+        thresholds: &[],
+    }).collect();
+    let (png, _) = generator.generate_panorama_grid_image(&cells)?;
+    std::fs::write(std::path::Path::new(&output).join("panorama_grid.png"), png)?;
+    Ok(())
+}
