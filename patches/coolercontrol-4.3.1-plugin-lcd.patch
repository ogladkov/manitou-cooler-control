+<script setup lang="ts">
+import { useI18n } from 'vue-i18n'
+import Select from 'primevue/select'
+import SensorStylePicker from './SensorStylePicker.vue'
+import GraphThresholdEditor from './GraphThresholdEditor.vue'
+import type { PanoramaCellDraft } from '@/utils/panorama'
+import type { TempSource } from '@/models/DaemonSettings'
+const { t } = useI18n()
+const cells = defineModel<PanoramaCellDraft[]>({ required: true })
+defineProps<{ sources: Array<{ deviceName: string; temps: Array<{
+    label: string; source: TempSource; unit: string
+}> }> }>()
+function update(index: number, patch: Partial<PanoramaCellDraft>) {
+    cells.value = cells.value.map((cell, i) => i === index ? { ...cell, ...patch } : cell)
+}
+</script>
+
+<template>
+    <div class="panorama-grid-editor">
+        <section v-for="plane in [0, 1]" :key="plane" class="panorama-grid-plane">
+            <h3 class="mb-4">{{ t(plane === 0 ? 'views.lcd.panoramaLeft' : 'views.lcd.panoramaRight') }}</h3>
+            <div class="panorama-grid-cells">
+                <section v-for="offset in [0, 1, 2, 3]" :key="offset" class="panorama-grid-cell">
+                    <h4 class="mb-3">{{ t('views.lcd.panoramaCell', { number: plane * 4 + offset + 1 }) }}</h4>
+                    <Select :model-value="cells[plane * 4 + offset].temp_source"
+                        :options="sources" option-group-label="deviceName" option-group-children="temps"
+                        option-label="label" option-value="source" filter class="w-full mb-4 min-w-0"
+                        :placeholder="t('views.lcd.tempSource')" :aria-label="t('views.lcd.panoramaCell', { number: plane * 4 + offset + 1 })"
+                        :invalid="!cells[plane * 4 + offset].temp_source"
+                        @update:model-value="update(plane * 4 + offset, { temp_source: $event })" />
+                    <SensorStylePicker :model-value="cells[plane * 4 + offset].sensor_style"
+                        :title="t('views.lcd.sensorStyle')" panorama split grid
+                        @update:model-value="update(plane * 4 + offset, { sensor_style: $event })" />
+                    <details>
+                        <summary class="cursor-pointer text-text-color-secondary mb-3">{{ t('views.lcd.graphColors') }}</summary>
+                        <GraphThresholdEditor :model-value="cells[plane * 4 + offset].graph_thresholds"
+                            :unit="sources.flatMap(group => group.temps).find(s =>
+                                s.source.device_uid === cells[plane * 4 + offset].temp_source?.device_uid &&
+                                s.source.temp_name === cells[plane * 4 + offset].temp_source?.temp_name)?.unit ?? '°C'"
+                            @update:model-value="update(plane * 4 + offset, { graph_thresholds: $event })" />
+                    </details>
+                </section>
+            </div>
+        </section>
+    </div>
+</template>
+
+<style scoped>
+.panorama-grid-editor, .panorama-grid-cells {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 1rem;
+}
+.panorama-grid-plane, .panorama-grid-cell { min-width: 0; }
+.panorama-grid-cell {
+    border: 1px solid rgb(var(--colors-border-one));
+    border-radius: 0.75rem;
+    padding: 1rem;
+}
+@container (min-width: 38rem) {
+    .panorama-grid-cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@container (min-width: 74rem) {
+    .panorama-grid-editor { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+</style>
