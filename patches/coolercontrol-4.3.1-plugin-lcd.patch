+<script setup lang="ts">
+import { computed } from 'vue'
+import { panoramaStyles } from '@/utils/panorama'
+const props = defineProps<{ modelValue: string; title: string; panorama?: boolean; split?: boolean; grid?: boolean }>()
+const emit = defineEmits<{ 'update:modelValue': [value: string] }>()
+const fanStyles = [
+    { id: 'classic', label: 'CoolerControl' },
+    { id: 'digital', label: 'Digital' },
+    { id: 'ring', label: 'Ring' },
+    { id: 'dial', label: 'Dial' },
+    { id: 'trend', label: 'Trend' },
+    { id: 'mono_minimal', label: 'Mono Minimal' },
+    { id: 'mono_dial', label: 'Mono Dial' },
+    { id: 'mono_segment', label: 'Mono Segment' },
+    { id: 'mono_graph', label: 'Mono Paper' },
+    { id: 'mono_orbit', label: 'Alien Orbit' },
+    { id: 'mono_relic', label: 'Alien Relic' },
+    { id: 'mono_signal', label: 'Alien Signal' },
+    { id: 'mono_trace', label: 'Mono Trace' },
+    { id: 'mono_reserve', label: 'Mono Reserve' },
+    { id: 'mono_reverse', label: 'Mono Reverse' },
+]
+const styles = computed(() => props.panorama ? panoramaStyles : fanStyles)
+</script>
+
+<template>
+    <fieldset class="mb-6">
+        <legend class="mb-3 text-text-color-secondary">{{ title }}</legend>
+        <div class="grid gap-3" :class="panorama ? 'grid-cols-3' : 'grid-cols-2'" role="group" :aria-label="title">
+            <button
+                v-for="style in styles"
+                :key="style.id"
+                type="button"
+                :aria-pressed="modelValue === style.id"
+                class="min-w-0 rounded-lg border-2 p-2 text-center transition-colors focus-visible:outline focus-visible:outline-2"
+                :class="modelValue === style.id ? 'border-cyan-400 bg-bg-two' : 'border-border-one hover:border-cyan-600'"
+                @click="emit('update:modelValue', style.id)"
+            >
+                <img :src="`/lcd-styles/${style.id}${panorama && grid ? '_cell' : panorama && split ? '_panel' : ''}.png`" alt="" width="160" :height="panorama && !split ? 77 : 160"
+                     class="w-full rounded-md object-contain bg-black"
+                     :style="{ aspectRatio: panorama ? (split ? '1120 / 1080' : '2240 / 1080') : '1' }" />
+                <span class="mt-2 block text-sm">{{ style.label }}</span>
+            </button>
+        </div>
+    </fieldset>
+</template>
