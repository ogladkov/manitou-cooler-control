@@ -0,0 +1,58 @@
+import { describe, it, expect, vi } from 'vitest'
+import { mount } from '@vue/test-utils'
+import PanoramaGridEditor from '../PanoramaGridEditor.vue'
+import { panoramaCells, serializePanoramaCells } from '@/utils/panorama'
+vi.mock('@/components/CCColorPicker.vue', () => ({ default: { name: 'CCColorPicker', template: '<span />' } }))
+vi.mock('vue-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }))
+
+const source = (i: number) => ({ device_uid: 'metrics', temp_name: `@percent:sensor${i}` })
+const saved = () => Array.from({length: 8}, (_,i) => ({temp_source: source(i), sensor_style: 'panorama_scope', graph_thresholds: [{value: 70+i, color: [255,0,0] as [number,number,number]}]}))
+
+describe('TRYX eight sensor grid', () => {
+    it('round trips all eight independent cells without aliasing saved settings', () => {
+        const original = saved()
+        const drafts = panoramaCells(original)
+        expect(serializePanoramaCells(drafts)).toEqual(original)
+        drafts[7].graph_thresholds[0].color[1] = 255
+        expect(original[7].graph_thresholds[0].color).toEqual([255,0,0])
+        expect(drafts[0].graph_thresholds[0].color).toEqual([255,0,0])
+    })
+    it('requires exactly eight selected sources and valid thresholds/styles', () => {
+        expect(serializePanoramaCells(panoramaCells())).toBeUndefined()
+        expect(serializePanoramaCells(panoramaCells(saved()).slice(1))).toBeUndefined()
+        const drafts = panoramaCells(saved())
+        drafts[7].graph_thresholds[0].value = null
+        expect(serializePanoramaCells(drafts)).toBeUndefined()
+        drafts[7].graph_thresholds = []
+        drafts[7].sensor_style = 'classic'
+        expect(serializePanoramaCells(drafts)).toBeUndefined()
+    })
+    it('edits a source, style and threshold only in the selected cell', async () => {
+        const drafts = panoramaCells(saved())
+        const wrapper = mount(PanoramaGridEditor, {
+            props: { modelValue: drafts, sources: [] },
+            global: { stubs: {
+                Select: { props: ['modelValue'], template: '<div class="source" />' },
+                GraphThresholdEditor: { props: ['modelValue'], template: '<div class="thresholds" />' },
+            } },
+        })
+        expect(wrapper.findAll('.panorama-grid-plane')).toHaveLength(2)
+        expect(wrapper.findAll('.panorama-grid-cell')).toHaveLength(8)
+        const cells = wrapper.findAll('.panorama-grid-cell')
+        cells[7].findComponent('.source').vm.$emit('update:modelValue', source(0))
+        await wrapper.vm.$nextTick()
+        let update = wrapper.emitted('update:modelValue')!.at(-1)![0] as typeof drafts
+        expect(update[7].temp_source).toEqual(source(0))
+        expect(update.slice(0,7)).toEqual(drafts.slice(0,7))
+        expect(drafts[7].temp_source).toEqual(source(7))
+        await cells[4].findAll('button')[0].trigger('click')
+        update = wrapper.emitted('update:modelValue')!.at(-1)![0] as typeof drafts
+        expect(update[4].sensor_style).toBe('panorama_minimal')
+        expect(update[5].sensor_style).toBe('panorama_scope')
+        cells[3].findComponent('.thresholds').vm.$emit('update:modelValue', [])
+        await wrapper.vm.$nextTick()
+        update = wrapper.emitted('update:modelValue')!.at(-1)![0] as typeof drafts
+        expect(update[3].graph_thresholds).toEqual([])
+        expect(update[2].graph_thresholds).toEqual(drafts[2].graph_thresholds)
+    })
+})
