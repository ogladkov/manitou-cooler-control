+    fn get_graph_thresholds(value: Option<&Value>) -> Result<Vec<crate::setting::LcdGraphThreshold>> {
+        let Some(value) = value else { return Ok(Vec::new()); };
+        let entries = value.as_array().context("Graph thresholds must be an array")?;
+        let mut thresholds = Vec::new();
+        for entry in entries {
+            let table = entry.as_inline_table().context("Graph threshold must be a table")?;
+            let at = table.get("value").context("Missing graph threshold value")?;
+            let at = at.as_float().or_else(|| at.as_integer().map(|v| v as f64))
+                .context("Graph threshold must be numeric")?;
+            let rgb = table.get("color").and_then(Value::as_array).context("Missing graph RGB color")?;
+            anyhow::ensure!(rgb.len() == 3, "Graph color requires three RGB components");
+            let mut color = [0u8; 3];
+            for (index, c) in rgb.iter().enumerate() {
+                color[index] = c.as_integer().and_then(|v| u8::try_from(v).ok())
+                    .context("Graph RGB components must be integers in 0..255")?;
+            }
+            thresholds.push(crate::setting::LcdGraphThreshold { value: at, color: (color[0], color[1], color[2]) });
+        }
+        crate::setting::LcdGraphThreshold::validate(&thresholds)?;
+        Ok(thresholds)
+    }
