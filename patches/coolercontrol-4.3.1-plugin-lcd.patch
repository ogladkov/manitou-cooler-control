+++ b/coolercontrold/cc-image/src/sensor_styles/alien.rs
@@ -0,0 +1,124 @@
+//! Original monochrome extraterrestrial instrument designs. GPL-3.0-or-later.
+use super::{SensorUnit, arc, line, paint, rect, text};
+use anyhow::{bail, Context, Result};
+use ril::{Font, Image, Rgba};
+use tiny_skia::{Color, FillRule, PathBuilder, Pixmap, Transform};
+
+const WHITE: (u8,u8,u8) = (232,232,232);
+const GRAY: (u8,u8,u8) = (125,125,125);
+const DIM: (u8,u8,u8) = (48,48,48);
+const BLACK: (u8,u8,u8) = (7,7,7);
+
+fn circle(canvas: &mut Pixmap, x: f32, y: f32, r: f32, color: (u8,u8,u8)) {
+    if let Some(path) = PathBuilder::from_circle(x,y,r) {
+        canvas.fill_path(&path,&paint(color),FillRule::Winding,Transform::identity(),None);
+    }
+}
+
+/// Invented glyphs are geometry, independent of system font coverage.
+fn glyph(canvas: &mut Pixmap, x: f32, y: f32, scale: f32, seed: usize, color: (u8,u8,u8)) {
+    let paths = [((0.0,0.0),(5.0,4.0)), ((5.0,4.0),(10.0,0.0)),
+                 ((5.0,4.0),(5.0,17.0)), ((0.0,9.0),(10.0,9.0)),
+                 ((0.0,13.0),(5.0,17.0)), ((5.0,17.0),(10.0,13.0)),
+                 ((0.0,0.0),(0.0,13.0)), ((10.0,0.0),(10.0,13.0))];
+    let mask = [0x75,0xab,0x9e,0x57,0xe3,0xbc,0x4f,0xda][seed % 8];
+    for (i,&(a,b)) in paths.iter().enumerate() {
+        if mask & (1 << i) != 0 {
+            line(canvas,&[(x+a.0*scale,y+a.1*scale),(x+b.0*scale,y+b.1*scale)],1.1,color);
+        }
+    }
+}
+
+fn glyph_row(canvas: &mut Pixmap, y: f32, seed: usize, color: (u8,u8,u8)) {
+    for i in 0..8 { glyph(canvas,88.0+i as f32*30.0,y,1.2,i+seed,color); }
+}
+
+pub(super) fn render(temp: f64, label: &str, style: &str, history: &[f64],
+                     mono: &Font, regular: &Font, unit: SensorUnit) -> Result<Image<Rgba>> {
+    let mut canvas = Pixmap::new(400,400).context("Alien sensor canvas")?;
+    canvas.fill(Color::from_rgba8(7,7,7,255));
+    let ratio = unit.ratio(temp);
+    match style {
+        "mono_orbit" => {
+            arc(&mut canvas,184.0,0.0,360.0,1.0,DIM);
+            for (rotation, minor) in [(35.0_f32,95.0_f32),(-35.0,95.0),(90.0,135.0)] {
+                let r = rotation.to_radians();
+                let points: Vec<_> = (0..=180).map(|i| {
+                    let a = (i as f32*2.0).to_radians();
+                    let (x,y) = (174.0*a.cos(),minor*a.sin());
+                    (200.0+x*r.cos()-y*r.sin(),200.0+x*r.sin()+y*r.cos())
+                }).collect();
+                line(&mut canvas,&points,1.0,GRAY);
+            }
+            for i in 0..48 {
+                let a = (i as f32*7.5).to_radians();
+                let r = if i%4==0 {176.0} else {180.0};
+                line(&mut canvas,&[(200.0+r*a.cos(),200.0+r*a.sin()),
+                                   (200.0+184.0*a.cos(),200.0+184.0*a.sin())],1.0,GRAY);
+            }
+            let a = (-90.0+ratio*360.0).to_radians();
+            circle(&mut canvas,200.0+174.0*a.cos(),200.0+174.0*a.sin(),7.0,BLACK);
+            circle(&mut canvas,200.0+174.0*a.cos(),200.0+174.0*a.sin(),3.5,WHITE);
+            circle(&mut canvas,200.0,200.0,116.0,BLACK);
+            for i in 0..4 { arc(&mut canvas,120.0,i as f32*90.0+12.0,66.0,1.0,DIM); }
+            glyph(&mut canvas,193.0,26.0,1.4,2,WHITE);
+            glyph(&mut canvas,193.0,348.0,1.4,4,WHITE);
+        }
+        "mono_relic" => {
+            glyph_row(&mut canvas,37.0,2,GRAY);
+            let outer = [(95.0,85.0),(305.0,85.0),(357.0,137.0),(357.0,263.0),
+                         (305.0,315.0),(95.0,315.0),(43.0,263.0),(43.0,137.0),(95.0,85.0)];
+            line(&mut canvas,&outer,1.0,GRAY);
+            let inner = [(110.0,101.0),(290.0,101.0),(336.0,147.0),(336.0,253.0),
+                         (290.0,299.0),(110.0,299.0),(64.0,253.0),(64.0,147.0),(110.0,101.0)];
+            line(&mut canvas,&inner,1.0,DIM);
+            for i in 0..8 {
+                line(&mut canvas,&[outer[i],inner[i]],1.0,DIM);
+                if (i as f32) < ratio*8.0 { line(&mut canvas,&[outer[i],outer[i+1]],2.5,WHITE); }
+            }
+            for i in 0..13 {
+                let y=128.0+i as f32*12.0;
+                rect(&mut canvas,24.0,y,5.0,3.0,if (i as f32)<ratio*13.0 {WHITE} else {DIM});
+                rect(&mut canvas,371.0,y,5.0,3.0,if (i as f32)<ratio*13.0 {WHITE} else {DIM});
+            }
+            glyph_row(&mut canvas,344.0,5,WHITE);
+        }
+        "mono_signal" => {
+            for i in 0..6 {
+                glyph(&mut canvas,23.0,40.0+i as f32*59.0,1.0,i,GRAY);
+                glyph(&mut canvas,367.0,40.0+i as f32*59.0,1.0,i+3,GRAY);
+            }
+            glyph_row(&mut canvas,80.0,0,GRAY);
+            for x in [52.0,348.0] {
+                let inward = if x<200.0 {12.0} else {-12.0};
+                line(&mut canvas,&[(x+inward,123.0),(x,123.0),(x,239.0),(x+inward,239.0)],1.0,GRAY);
+            }
+            for i in 0..4 {
+                let y=269.0+i as f32*24.0;
+                line(&mut canvas,&[(62.0,y),(338.0,y)],1.0,(26,26,26));
+            }
+            let samples: Vec<_> = history.iter().rev().take(60).copied().collect::<Vec<_>>()
+                .into_iter().rev().collect();
+            let points: Vec<_> = samples.iter().enumerate().map(|(i,v)| {
+                (338.0-(samples.len()-1-i) as f32*276.0/59.0,341.0-(unit.ratio(*v) * 100.0)*0.72)
+            }).collect();
+            if points.len()>1 { line(&mut canvas,&points,1.5,WHITE); }
+            if let Some(&(x,y)) = points.last() { circle(&mut canvas,x,y,3.0,WHITE); }
+            for i in 0..20 {
+                rect(&mut canvas,64.0+i as f32*14.0,362.0,if i%3==0 {7.0} else {2.0},8.0,
+                     if (i as f32)<ratio*20.0 {GRAY} else {DIM});
+            }
+        }
+        _ => bail!("Unknown alien sensor style: {style}"),
+    }
+    let pixels = canvas.pixels().iter().map(|p|Rgba::new(p.red(),p.green(),p.blue(),p.alpha())).collect::<Vec<_>>();
+    let mut image = Image::from_pixels(400,pixels);
+    let label: String = label.chars().take(18).collect();
+    let value = unit.value(temp);
+    let size = if value.len()>5 {52.0} else {66.0};
+    let (label_y,value_y,unit_y) = if style=="mono_signal" {(42,169,218)} else {(141,202,257)};
+    text(&mut image,regular,&label,17.0,200,label_y,GRAY);
+    text(&mut image,mono,&value,size,200,value_y,WHITE);
+    text(&mut image,mono,unit.symbol(),19.0,200,unit_y,GRAY);
+    Ok(image)
+}
diff --git a/coolercontrold/cc-image/src/sensor_styles/monochrome.rs b/coolercontrold/cc-image/src/sensor_styles/monochrome.rs
