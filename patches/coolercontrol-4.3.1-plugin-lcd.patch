--- /dev/null
+++ b/coolercontrol-ui/src/utils/graphThresholds.ts
@@ -0,0 +1,11 @@
+export interface GraphThresholdDraft {
+    value: number | null
+    color: [number, number, number]
+}
+
+export function graphThresholdsValid(rows: GraphThresholdDraft[]): boolean {
+    return rows.length <= 8 && rows.every((row, i) =>
+        row.value != null && Number.isFinite(row.value) &&
+        !rows.slice(0, i).some(other => other.value === row.value) &&
+        row.color.length === 3 && row.color.every(c => Number.isInteger(c) && c >= 0 && c <= 255))
+}
diff --git a/coolercontrol-ui/src/utils/lcdSensors.ts b/coolercontrol-ui/src/utils/lcdSensors.ts
