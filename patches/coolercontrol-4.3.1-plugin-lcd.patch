@@ -0,0 +1,129 @@
+//! Grayscale sensor layouts. No temperature-dependent colour accents.
+use super::{SensorUnit, arc, line, paint, rect, text};
+use anyhow::{bail, Context, Result};
+use ril::{Font, Image, Rgba};
+use tiny_skia::{Color, FillRule, PathBuilder, Pixmap, Transform};
+
+const WHITE: (u8, u8, u8) = (238, 238, 238);
+const GRAY: (u8, u8, u8) = (133, 133, 133);
+const DIM: (u8, u8, u8) = (47, 47, 47);
+
+fn dot(canvas: &mut Pixmap, x: f32, y: f32, radius: f32, color: (u8,u8,u8)) {
+    if let Some(path) = PathBuilder::from_circle(x, y, radius) {
+        canvas.fill_path(&path, &paint(color), FillRule::Winding, Transform::identity(), None);
+    }
+}
+
+/// Seven-segment digits drawn as geometry, including a decimal point and sign.
+fn segments(canvas: &mut Pixmap, value: &str) {
+    let units: f32 = value.chars().map(|c| if c == '.' { 0.3 } else { 1.0 }).sum();
+    let scale = (328.0 / (units * 58.0)).min(1.4);
+    let width = units * 58.0 * scale;
+    let mut x = (400.0 - width) / 2.0;
+    let y = 154.0;
+    let paths = [((8.0,0.0),(40.0,0.0)), ((46.0,8.0),(46.0,40.0)),
+                 ((46.0,54.0),(46.0,86.0)), ((8.0,94.0),(40.0,94.0)),
+                 ((2.0,54.0),(2.0,86.0)), ((2.0,8.0),(2.0,40.0)),
+                 ((8.0,47.0),(40.0,47.0))];
+    let masks = [0x3f,0x06,0x5b,0x4f,0x66,0x6d,0x7d,0x07,0x7f,0x6f];
+    for c in value.chars() {
+        if c == '.' {
+            dot(canvas, x + 4.0*scale, y + 94.0*scale, 3.2*scale, WHITE);
+            x += 17.4*scale;
+            continue;
+        }
+        let mask = c.to_digit(10).map_or(0x40, |n| masks[n as usize]);
+        for (index, &(a,b)) in paths.iter().enumerate() {
+            line(canvas, &[(x+a.0*scale,y+a.1*scale),(x+b.0*scale,y+b.1*scale)],
+                 4.5*scale, if mask & (1 << index) != 0 { WHITE } else { (26,26,26) });
+        }
+        x += 58.0*scale;
+    }
+}
+
+pub(super) fn render(temp: f64, label: &str, style: &str, history: &[f64],
+                     mono: &Font, regular: &Font, unit: SensorUnit) -> Result<Image<Rgba>> {
+    let mut canvas = Pixmap::new(400,400).context("Monochrome sensor canvas")?;
+    let paper = style == "mono_graph";
+    canvas.fill(if paper { Color::from_rgba8(0,0,0,255) }
+                else { Color::from_rgba8(8,8,8,255) });
+    let ratio = unit.ratio(temp);
+    let value = unit.value(temp);
+    match style {
+        "mono_minimal" => {
+            line(&mut canvas, &[(174.0,88.0),(226.0,88.0)], 1.0, GRAY);
+            line(&mut canvas, &[(60.0,322.0),(340.0,322.0)], 1.0, DIM);
+            line(&mut canvas, &[(60.0,322.0),(60.0 + 280.0*ratio,322.0)], 2.0, WHITE);
+            dot(&mut canvas, 60.0 + 280.0*ratio, 322.0, 3.0, WHITE);
+        }
+        "mono_dial" => {
+            arc(&mut canvas,178.0,0.0,360.0,1.0,DIM);
+            for i in 0..=50 {
+                let a = (135.0 + i as f32 * 5.4).to_radians();
+                let r = if i % 5 == 0 {153.0} else {161.0};
+                line(&mut canvas, &[(200.0+r*a.cos(),200.0+r*a.sin()),
+                                   (200.0+170.0*a.cos(),200.0+170.0*a.sin())],
+                     if i % 5 == 0 {2.0} else {1.0}, if i % 5 == 0 {WHITE} else {GRAY});
+            }
+            let a = (135.0 + ratio * 270.0).to_radians();
+            line(&mut canvas, &[(200.0-14.0*a.cos(),200.0-14.0*a.sin()),
+                               (200.0+137.0*a.cos(),200.0+137.0*a.sin())], 2.0, WHITE);
+            dot(&mut canvas,200.0,200.0,5.0,WHITE);
+            dot(&mut canvas,200.0,200.0,2.0,(8,8,8));
+        }
+        "mono_segment" => {
+            line(&mut canvas, &[(36.0,103.0),(364.0,103.0)], 1.0, DIM);
+            segments(&mut canvas, &value);
+            for i in 0..24 {
+                rect(&mut canvas, 45.0+i as f32*13.0, 332.0, 8.0, 9.0,
+                     if (i as f32) < ratio*24.0 {WHITE} else {DIM});
+            }
+        }
+        "mono_graph" => {
+            line(&mut canvas,&[(30.0,78.0),(370.0,78.0)],1.0,DIM);
+            for i in 0..=4 {
+                let y = 227.0+i as f32*25.0;
+                line(&mut canvas,&[(32.0,y),(368.0,y)],1.0,DIM);
+            }
+            let samples: Vec<_> = history.iter().rev().take(60).copied().collect::<Vec<_>>()
+                .into_iter().rev().collect();
+            let points: Vec<_> = samples.iter().enumerate().map(|(i,v)| {
+                (368.0 - (samples.len()-1-i) as f32*336.0/59.0,
+                 327.0 - (unit.ratio(*v) * 100.0))
+            }).collect();
+            if points.len() > 1 { line(&mut canvas,&points,2.0,WHITE); }
+            if let Some(&(x,y)) = points.last() { dot(&mut canvas,x,y,3.0,WHITE); }
+        }
+        _ => bail!("Unknown monochrome style: {style}"),
+    }
+    let pixels = canvas.pixels().iter().map(|p| Rgba::new(p.red(),p.green(),p.blue(),p.alpha())).collect::<Vec<_>>();
+    let mut image = Image::from_pixels(400,pixels);
+    let label: String = label.chars().take(22).collect();
+    match style {
+        "mono_minimal" => {
+            text(&mut image,regular,&label,19.0,200,54,GRAY);
+            text(&mut image,regular,&value,if value.len()>5 {90.0} else {112.0},200,175,WHITE);
+            text(&mut image,regular,unit.symbol(),23.0,200,263,GRAY);
