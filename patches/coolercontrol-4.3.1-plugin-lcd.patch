+impl LcdGraphThreshold {
+    pub fn validate(thresholds: &[Self]) -> anyhow::Result<()> {
+        anyhow::ensure!(thresholds.len() <= 8, "At most 8 graph color thresholds are supported");
+        for (i, threshold) in thresholds.iter().enumerate() {
+            anyhow::ensure!(threshold.value.is_finite(), "Graph threshold must be finite");
+            anyhow::ensure!(!thresholds[..i].iter().any(|t| t.value == threshold.value),
+                            "Graph threshold values must be unique");
+        }
+        Ok(())
+    }
