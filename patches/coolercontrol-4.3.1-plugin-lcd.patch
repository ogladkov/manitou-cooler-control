new file mode 100644
index 0000000..1689784
--- /dev/null
+++ b/coolercontrold/cc-image/examples/metric_previews.rs
@@ -0,0 +1,22 @@
+use cc_image::{LcdImageGenerator, SensorUnit, SENSOR_STYLES};
+
+fn main() -> anyhow::Result<()> {
+    let output = std::path::PathBuf::from(std::env::args().nth(1).expect("output directory"));
+    std::fs::create_dir_all(&output)?;
+    let generator = LcdImageGenerator::new();
+    for style in SENSOR_STYLES {
+        for (name, label, unit, value) in [
+            ("rpm", "TL FAN 1", SensorUnit::Rpm, 1850.0),
+            ("cpu", "CPU LOAD", SensorUnit::Percent, 37.5),
+            ("gpu", "GPU LOAD", SensorUnit::Percent, 88.0),
+            ("ram", "RAM USED", SensorUnit::Percent, 62.4),
+            ("vram", "VRAM USED", SensorUnit::Percent, 66.0),
+            ("missing", "NO DATA", SensorUnit::Percent, f64::NAN),
+        ] {
+            let history: Vec<_> = (0..60).map(|i| unit.maximum() * (0.5 + (i as f64 * 0.2).sin()*0.2)).collect();
+            let png = generator.generate_metric_image(value, label, style, &history, None, unit)?.0;
+            std::fs::write(output.join(format!("{style}-{name}.png")), png)?;
+        }
+    }
+    Ok(())
+}
