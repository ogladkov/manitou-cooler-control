+import 'reflect-metadata'
+import { describe, it, expect } from 'vitest'
+import { Status, ChannelStatus, TempStatus } from '@/models/Status'
+import { lcdSensors } from '../lcdSensors'
+
+describe('LCD metric sources', () => {
+    it('offers remaining weekly quota as a percent including exhausted buckets', () => {
+        const names = ['openai_weekly_remaining', 'openai_weekly_0123456789ab_remaining']
+        const status = new Status(new Date().toISOString(), [], names.map((name, i) =>
+            new ChannelStatus(name, undefined, i === 0 ? 82 : 0)))
+        expect(lcdSensors(status)).toEqual(names.map((name, i) => ({
+            id: `@percent:${name}`, channel: name, value: i === 0 ? '82.0' : '0.0', unit: '%',
+        })))
+    })
+    it('preserves temperature IDs and distinguishes RPM, PWM and utilization', () => {
+        const status = new Status(new Date().toISOString(), [new TempStatus('temp1', 62.5)], [
+            new ChannelStatus('fan1', 0, 55), new ChannelStatus('CPU Load', undefined, 18),
+            new ChannelStatus('ram_load', undefined, 60), new ChannelStatus('vram_x_load', undefined, 40),
+        ])
+        expect(lcdSensors(status)).toEqual([
+            { id: 'temp1', channel: 'temp1', value: '62.5', unit: '°C' },
+            { id: '@rpm:fan1', channel: 'fan1', value: '0', unit: 'RPM' },
+            { id: '@percent:CPU Load', channel: 'CPU Load', value: '18.0', unit: '%' },
+            { id: '@percent:ram_load', channel: 'ram_load', value: '60.0', unit: '%' },
+            { id: '@percent:vram_x_load', channel: 'vram_x_load', value: '40.0', unit: '%' },
+        ])
+    })
+    it('does not show stale or invalid samples as zero', () => {
+        const stale = new Status(new Date(Date.now() - 6000).toISOString(), [], [new ChannelStatus('fan1', 1200)])
+        expect(lcdSensors(stale)[0].value).toBe('--')
+        const invalid = new Status(new Date().toISOString(), [], [new ChannelStatus('load', undefined, NaN)])
+        expect(lcdSensors(invalid)[0].value).toBe('--')
+    })
+})
diff --git a/coolercontrol-ui/src/utils/graphThresholds.ts b/coolercontrol-ui/src/utils/graphThresholds.ts
