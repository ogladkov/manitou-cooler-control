+import 'reflect-metadata'
+import { describe, it, expect, vi } from 'vitest'
+import { mount } from '@vue/test-utils'
+import GraphThresholdEditor from '../GraphThresholdEditor.vue'
+import { graphThresholdsValid } from '@/utils/graphThresholds'
+
+vi.mock('vue-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }))
+vi.mock('@/components/CCColorPicker.vue', () => ({ default: { name: 'CCColorPicker', template: '<span />' } }))
+
+describe('graph thresholds', () => {
+    it('adds, edits colors and values, and removes a rule without mutating saved settings', async () => {
+        const saved: any[] = []
+        const wrapper = mount(GraphThresholdEditor, {
+            props: { modelValue: saved, unit: 'RPM' },
+            global: { stubs: {
+                Button: { props: ['label', 'disabled'], emits: ['click'], template: '<button :disabled="disabled" @click="$emit(\'click\')">{{label}}</button>' },
+                InputNumber: { props: ['modelValue'], emits: ['update:modelValue'], template: '<input :value="modelValue" @input="$emit(\'update:modelValue\', Number($event.target.value))" />' },
+                CCColorPicker: { emits: ['update:modelValue'], template: '<button data-test="color" @click="$emit(\'update:modelValue\', \'rgb(0, 120, 255)\')">Color</button>' },
+            } },
+        })
+        const lastRows = () => wrapper.emitted('update:modelValue')!.at(-1)![0] as any[]
+        await wrapper.findAll('button').find(b => b.text().includes('graphAdd'))!.trigger('click')
+        expect(saved).toEqual([])
+        expect(lastRows()[0].value).toBe(1500)
+        await wrapper.setProps({ modelValue: lastRows() })
+        await wrapper.find('input').setValue('1800')
+        expect(lastRows()[0].value).toBe(1800)
+        await wrapper.setProps({ modelValue: lastRows() })
+        await wrapper.find('[data-test="color"]').trigger('click')
+        expect(lastRows()[0].color).toEqual([0,120,255])
+        await wrapper.setProps({ modelValue: lastRows() })
+        await wrapper.find('[aria-label="views.lcd.graphRemove"]').trigger('click')
+        expect(lastRows()).toEqual([])
+    })
+    it('accepts empty and unsorted thresholds but rejects ambiguous or invalid entries', () => {
+        expect(graphThresholdsValid([])).toBe(true)
+        expect(graphThresholdsValid([{value:85,color:[255,0,0]}, {value:70,color:[255,160,40]}])).toBe(true)
+        for (const rows of [
+            [{value:null,color:[255,0,0]}], [{value:NaN,color:[255,0,0]}],
+            [{value:70,color:[256,0,0]}], [{value:70,color:[255,0,0]},{value:70,color:[0,255,0]}],
+            Array.from({length:9}, (_, i) => ({value:i,color:[255,255,255]})),
+        ]) expect(graphThresholdsValid(rows as any)).toBe(false)
+    })
+})
