@@ -0,0 +1,141 @@
+//! Native panoramic layouts; no square fan artwork is resized or embedded.
+use super::*;
+
+pub const PANORAMA_STYLES: &[&str] = &["panorama_minimal", "panorama_scope", "panorama_trace"];
+
+/// Migrate existing fan layouts on TRYX to a native panoramic equivalent.
+pub fn panorama_style(style: &str) -> Option<&'static str> {
+    match style {
+        "panorama_trace" | "mono_trace" => Some("panorama_trace"),
+        "panorama_scope" | "trend" | "mono_graph" | "mono_signal" | "mono_reverse" => Some("panorama_scope"),
+        "panorama_minimal" => Some("panorama_minimal"),
+        style if SENSOR_STYLES.contains(&style) => Some("panorama_minimal"),
+        _ => None,
+    }
+}
+
+pub struct PanoramaPanel<'a> {
+    pub value: f64,
+    pub label: &'a str,
+    pub style: &'a str,
+    pub history: &'a [f64],
+    pub unit: SensorUnit,
+    pub thresholds: &'a [(f64, (u8, u8, u8))],
+}
+
+fn trace(canvas: &mut Pixmap, panel: &PanoramaPanel<'_>, bounds: (f32, f32, f32, f32)) {
+    let (x, y, width, height) = bounds;
+    if !panel.value.is_finite() { return; }
+    let fallback = [panel.value];
+    let samples = if panel.history.is_empty() { &fallback[..] } else { panel.history };
+    let samples = &samples[samples.len().saturating_sub(60)..];
+    let color = graph_color(panel.value, panel.thresholds);
+    let mut points = Vec::new();
+    for (i, sample) in samples.iter().enumerate() {
+        if !sample.is_finite() {
+            if points.len() > 1 { line(canvas, &points, 5.0, color); }
+            points.clear();
+            continue;
+        }
+        points.push((x + width - (samples.len() - 1 - i) as f32 * width / 59.0,
+                     y + height * (1.0 - panel.unit.ratio(*sample))));
+    }
+    if points.len() > 1 { line(canvas, &points, 5.0, color); }
+    else if let Some(&(x, y)) = points.last() {
+        if let Some(dot) = PathBuilder::from_circle(x, y, 3.0) {
+            canvas.fill_path(&dot, &paint(color), FillRule::Winding, Transform::identity(), None);
+        }
+    }
+}
+
+pub fn render(left: PanoramaPanel<'_>, right: Option<PanoramaPanel<'_>>,
+              mono: &Font, regular: &Font) -> Result<Image<Rgba>> {
+    let split = right.is_some();
+    let width = if split { 1120.0 } else { 2240.0 };
+    let margin = if split { 72.0 } else { 112.0 };
+    let panels: Vec<_> = std::iter::once(left).chain(right).collect();
+    let mut canvas = Pixmap::new(2240, 1080).context("Panorama canvas")?;
+    canvas.fill(Color::from_rgba8(0, 0, 0, 255));
+    for (index, panel) in panels.iter().enumerate() {
+        anyhow::ensure!(PANORAMA_STYLES.contains(&panel.style), "Unknown panorama style");
+        let x = index as f32 * width + margin;
+        let inner = width - 2.0 * margin;
+        let color = graph_color(panel.value, panel.thresholds);
+        match panel.style {
+            "panorama_trace" => trace(&mut canvas, panel, (x, 120.0, inner, 840.0)),
+            "panorama_scope" => {
+                for i in 0..=2 {
+                    let y = 570.0 + i as f32 * 150.0;
+                    line(&mut canvas, &[(x, y), (x + inner, y)], 1.0, (35,35,35));
+                }
+                trace(&mut canvas, panel, (x, 570.0, inner, 300.0));
+            }
+            _ => {
+                line(&mut canvas, &[(x, 850.0), (x + inner, 850.0)], 2.0, (40,40,40));
+                if panel.value.is_finite() && panel.unit.ratio(panel.value) > 0.0 {
+                    line(&mut canvas, &[(x, 850.0), (x + inner * panel.unit.ratio(panel.value), 850.0)], 6.0, color);
+                }
+            }
+        }
+    }
+    let mut image = Image::from_pixels(2240, canvas.pixels().iter()
+        .map(|p| Rgba::new(p.red(), p.green(), p.blue(), p.alpha())).collect::<Vec<_>>());
+    for (index, panel) in panels.iter().enumerate() {
+        if panel.style == "panorama_trace" { continue; }
+        let center = (index as f32 * width + width / 2.0) as u32;
+        let label: String = panel.label.chars().take(if split { 25 } else { 48 }).collect();
+        let color = graph_color(panel.value, panel.thresholds);
+        text(&mut image, regular, &label, if split { 42.0 } else { 54.0 }, center, 145, (170,170,170));
+        let scope = panel.style == "panorama_scope";
+        text(&mut image, mono, &panel.unit.value(panel.value),
+             if split { 190.0 } else { 250.0 }, center, if scope { 345 } else { 460 }, color);
+        text(&mut image, regular, panel.unit.symbol(), 44.0, center,
+             if scope { 485 } else { 650 }, (170,170,170));
+    }
+    Ok(image)
+}
+
+/// Native 560×540 cells: 1–4 on the left physical plane, 5–8 on the right.
+/// Gutters remain clear around the fold at x=1120.
+pub fn render_grid(panels: &[PanoramaPanel<'_>], mono: &Font, regular: &Font) -> Result<Image<Rgba>> {
+    anyhow::ensure!(panels.len() == 8, "Panorama grid requires exactly eight sensors");
+    let mut canvas = Pixmap::new(2240, 1080).context("Panorama grid canvas")?;
+    canvas.fill(Color::from_rgba8(0, 0, 0, 255));
+    for (i, panel) in panels.iter().enumerate() {
+        anyhow::ensure!(PANORAMA_STYLES.contains(&panel.style), "Unknown panorama style");
+        let x = (i / 4 * 1120 + i % 2 * 560) as f32 + 48.0;
+        let y = (i % 4 / 2 * 540) as f32;
+        let color = graph_color(panel.value, panel.thresholds);
+        match panel.style {
+            "panorama_trace" => trace(&mut canvas, panel, (x, y + 64.0, 464.0, 412.0)),
+            "panorama_scope" => {
+                for offset in [0.0, 70.0, 140.0] {
+                    line(&mut canvas, &[(x, y + 330.0 + offset), (x + 464.0, y + 330.0 + offset)], 1.0, (35,35,35));
+                }
+                trace(&mut canvas, panel, (x, y + 330.0, 464.0, 140.0));
+            }
+            _ => {
+                line(&mut canvas, &[(x, y + 450.0), (x + 464.0, y + 450.0)], 2.0, (40,40,40));
+                if panel.value.is_finite() && panel.unit.ratio(panel.value) > 0.0 {
+                    line(&mut canvas, &[(x, y + 450.0), (x + 464.0 * panel.unit.ratio(panel.value), y + 450.0)], 5.0, color);
+                }
+            }
+        }
+    }
+    let mut image = Image::from_pixels(2240, canvas.pixels().iter()
+        .map(|p| Rgba::new(p.red(), p.green(), p.blue(), p.alpha())).collect::<Vec<_>>());
+    for (i, panel) in panels.iter().enumerate() {
+        if panel.style == "panorama_trace" { continue; }
+        let center = (i / 4 * 1120 + i % 2 * 560 + 280) as u32;
+        let y = (i % 4 / 2 * 540) as u32;
+        let label: String = panel.label.chars().take(16).collect();
+        text(&mut image, regular, &label, 28.0, center, y + 64, (170,170,170));
+        let color = graph_color(panel.value, panel.thresholds);
+        let scope = panel.style == "panorama_scope";
+        text(&mut image, mono, &panel.unit.value(panel.value), 96.0, center,
+             y + if scope { 182 } else { 224 }, color);
+        text(&mut image, regular, panel.unit.symbol(), 28.0, center,
+             y + if scope { 270 } else { 330 }, (170,170,170));
+    }
+    Ok(image)
+}
