+//! Original sensor layouts inspired by instrument displays. GPL-3.0-or-later.
+use anyhow::{bail, Context, Result};
+use ril::{Draw, Font, Image, Rgba, TextAlign, TextLayout, TextSegment};
+use tiny_skia::{Color, FillRule, LineCap, Paint, PathBuilder, Pixmap, Rect, Stroke, Transform};
+
+mod monochrome;
+mod alien;
+pub mod panorama;
+
+pub const SENSOR_STYLES: &[&str] = &["classic", "digital", "ring", "dial", "trend",
+    "mono_minimal", "mono_dial", "mono_segment", "mono_graph",
+    "mono_orbit", "mono_relic", "mono_signal", "mono_trace", "mono_reserve", "mono_reverse"];
+
+pub fn sensor_style_uses_history(style: &str) -> bool {
+    matches!(style, "panorama_scope" | "panorama_trace" | "trend" | "mono_graph" | "mono_signal" | "mono_trace" | "mono_reverse")
+}
+
+/// The highest reached threshold colors the whole trace. Input order is irrelevant.
+pub(crate) fn graph_color(value: f64, thresholds: &[(f64, (u8, u8, u8))]) -> (u8, u8, u8) {
+    thresholds.iter().filter(|(at, _)| at.is_finite() && value.is_finite() && value >= *at)
+        .max_by(|a, b| a.0.total_cmp(&b.0)).map_or((255, 255, 255), |(_, color)| *color)
+}
+
+pub(crate) fn render_graph(value: f64, history: &[f64], unit: SensorUnit,
+                          thresholds: &[(f64, (u8, u8, u8))]) -> Result<Image<Rgba>> {
+    let mut canvas = Pixmap::new(400, 400).context("Minimal graph canvas")?;
+    canvas.fill(Color::from_rgba8(0, 0, 0, 255));
+    draw_trace(&mut canvas, value, history, unit, thresholds, (24.0, 40.0, 352.0, 320.0));
+    Ok(Image::from_pixels(400, canvas.pixels().iter()
+        .map(|p| Rgba::new(p.red(), p.green(), p.blue(), p.alpha())).collect::<Vec<_>>()))
+}
+
+fn draw_trace(canvas: &mut Pixmap, value: f64, history: &[f64], unit: SensorUnit,
+              thresholds: &[(f64, (u8, u8, u8))], bounds: (f32, f32, f32, f32)) {
+    let (left, top, width, height) = bounds;
+    if value.is_finite() {
+        let fallback = [value];
+        let history = if history.is_empty() { &fallback[..] } else { history };
+        let samples: Vec<_> = history.iter().rev().take(60).copied().collect::<Vec<_>>()
+            .into_iter().rev().collect();
+        let color = graph_color(value, thresholds);
+        let mut points = Vec::new();
+        for (i, sample) in samples.iter().enumerate() {
+            if !sample.is_finite() { points.clear(); continue; }
+            points.push((left + width - (samples.len()-1-i) as f32 * width / 59.0,
+                         top + height - unit.ratio(*sample) * height));
+        }
+        if points.len() > 1 { line(canvas, &points, 2.5, color); }
+        else if let Some(&(x, y)) = points.first() {
+            if let Some(dot) = PathBuilder::from_circle(x, y, 1.5) {
+                canvas.fill_path(&dot, &paint(color), FillRule::Winding, Transform::identity(), None);
+            }
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum SensorUnit { Celsius, Percent, Rpm }
+
+impl SensorUnit {
+    pub fn symbol(self) -> &'static str {
+        match self { Self::Celsius => "°C", Self::Percent => "%", Self::Rpm => "RPM" }
+    }
+    pub fn maximum(self) -> f64 { if self == Self::Rpm { 4000.0 } else { 100.0 } }
+    pub fn ratio(self, value: f64) -> f32 {
+        if value.is_finite() { (value / self.maximum()).clamp(0.0, 1.0) as f32 } else { 0.0 }
+    }
+    pub fn value(self, value: f64) -> String {
+        if !value.is_finite() { return "--".to_owned(); }
+        if self == Self::Rpm { format!("{value:.0}") } else { format!("{value:.1}") }
+    }
+    pub fn reading(self, value: f64) -> String { format!("{} {}", self.value(value), self.symbol()) }
+    pub fn range(self) -> String { format!("0–{:.0} {}", self.maximum(), self.symbol()) }
+}
+
+const CYAN: (u8, u8, u8) = (0, 210, 255);
+const DIM: (u8, u8, u8) = (27, 47, 67);
+const MUTED: (u8, u8, u8) = (133, 161, 182);
+
+fn paint(rgb: (u8, u8, u8)) -> Paint<'static> {
+    let mut paint = Paint::default();
+    paint.set_color_rgba8(rgb.0, rgb.1, rgb.2, 255);
+    paint.anti_alias = true;
+    paint
+}
+
+fn line(canvas: &mut Pixmap, points: &[(f32, f32)], width: f32, color: (u8, u8, u8)) {
+    let mut path = PathBuilder::new();
+    for (index, &(x, y)) in points.iter().enumerate() {
+        if index == 0 { path.move_to(x, y); } else { path.line_to(x, y); }
+    }
+    if let Some(path) = path.finish() {
+        let stroke = Stroke { width, line_cap: LineCap::Round, ..Stroke::default() };
+        canvas.stroke_path(&path, &paint(color), &stroke, Transform::identity(), None);
+    }
+}
+
+fn arc(canvas: &mut Pixmap, radius: f32, start: f32, sweep: f32, width: f32, color: (u8,u8,u8)) {
+    if sweep <= 0.0 { return; }
+    let points: Vec<_> = (0..=180).map(|i| {
+        let angle = (start + sweep * i as f32 / 180.0).to_radians();
+        (200.0 + radius * angle.cos(), 200.0 + radius * angle.sin())
+    }).collect();
+    line(canvas, &points, width, color);
+}
+
+fn rect(canvas: &mut Pixmap, x: f32, y: f32, w: f32, h: f32, color: (u8,u8,u8)) {
+    if let Some(r) = Rect::from_xywh(x, y, w, h) {
+        canvas.fill_rect(r, &paint(color), Transform::identity(), None);
+    }
+}
+
+fn text(image: &mut Image<Rgba>, font: &Font, value: &str, size: f32,
+        x: u32, y: u32, color: (u8,u8,u8)) {
+    TextLayout::new().with_align(TextAlign::Center).centered().with_position(x, y)
+        .with_segment(&TextSegment::new(font, value, Rgba::new(color.0, color.1, color.2, 255))
+            .with_size(size)).draw(image);
+}
+
+pub(crate) fn render_reserve_ring(temp: f64, history: &[f64], unit: SensorUnit,
+                                  with_trace: bool, thresholds: &[(f64, (u8, u8, u8))])
+    -> Result<Image<Rgba>> {
+    let mut canvas = Pixmap::new(400, 400).context("Reserve ring canvas")?;
+    canvas.fill(Color::from_rgba8(0, 0, 0, 255));
+    // The source is remaining capacity already: do not invert it again.
+    // No background track; an exhausted quota removes the ring entirely.
+    if temp.is_finite() {
+        arc(&mut canvas, 145.0, -90.0, 360.0 * unit.ratio(temp), 8.0, graph_color(temp, thresholds));
+        if with_trace {
+            // All four corners and the stroke fit inside the ring's inner radius.
+            draw_trace(&mut canvas, temp, history, unit, thresholds, (90.0, 120.0, 220.0, 160.0));
+        }
+    } else {
+        line(&mut canvas, &[(180.0, 200.0), (191.0, 200.0)], 2.0, (150, 150, 150));
+        line(&mut canvas, &[(209.0, 200.0), (220.0, 200.0)], 2.0, (150, 150, 150));
+    }
+    Ok(Image::from_pixels(400, canvas.pixels().iter()
+        .map(|p| Rgba::new(p.red(), p.green(), p.blue(), p.alpha())).collect::<Vec<_>>()))
+}
+
+pub fn render(temp: f64, label: &str, style: &str, history: &[f64],
+              mono: &Font, regular: &Font, unit: SensorUnit) -> Result<Image<Rgba>> {
+    if style == "mono_trace" { return render_graph(temp, history, unit, &[]); }
+    if matches!(style, "mono_reserve" | "mono_reverse") {
+        return render_reserve_ring(temp, history, unit, style == "mono_reverse", &[]);
+    }
+    if matches!(style, "mono_orbit" | "mono_relic" | "mono_signal") {
+        return alien::render(temp, label, style, history, mono, regular, unit);
+    }
+    if style.starts_with("mono_") {
+        return monochrome::render(temp, label, style, history, mono, regular, unit);
+    }
+    let mut canvas = Pixmap::new(400, 400).context("Sensor canvas")?;
+    canvas.fill(Color::from_rgba8(5, 12, 21, 255));
+    let color = if unit == SensorUnit::Celsius && temp >= 85.0 { (255, 105, 74) } else { CYAN };
+    let ratio = unit.ratio(temp);
+    match style {
+        "digital" => {
+            rect(&mut canvas, 32.0, 33.0, 4.0, 38.0, color);
+            line(&mut canvas, &[(32.0, 285.0), (368.0, 285.0)], 1.0, DIM);
+            for i in 0..40 {
+                rect(&mut canvas, 33.0 + i as f32 * 8.4, 314.0, 5.0, 30.0,
+                     if (i as f32) < ratio * 40.0 { color } else { DIM });
+            }
+        }
+        "classic" | "ring" => {
+            arc(&mut canvas, 168.0, 135.0, 270.0, 15.0, DIM);
+            arc(&mut canvas, 168.0, 135.0, ratio * 270.0, 15.0, color);
+            arc(&mut canvas, 145.0, 135.0, 270.0, 1.0, DIM);
+            for i in 0..=20 {
+                let a = (135.0 + i as f32 * 13.5).to_radians();
+                line(&mut canvas, &[(200.0 + 184.0*a.cos(), 200.0 + 184.0*a.sin()),
+                                   (200.0 + 190.0*a.cos(), 200.0 + 190.0*a.sin())], 2.0, MUTED);
+            }
+        }
+        "dial" => {
+            arc(&mut canvas, 171.0, 140.0, 260.0, 2.0, DIM);
+            for i in 0..=50 {
+                let a = (140.0 + i as f32 * 5.2).to_radians();
+                let inner = if i % 5 == 0 { 143.0 } else { 153.0 };
+                line(&mut canvas, &[(200.0 + inner*a.cos(), 200.0 + inner*a.sin()),
+                                   (200.0 + 166.0*a.cos(), 200.0 + 166.0*a.sin())],
+                     if i % 5 == 0 {3.0} else {1.0}, if unit == SensorUnit::Celsius && i >= 40 {(255,105,74)} else {MUTED});
+            }
+            let a = (140.0 + ratio * 260.0).to_radians();
+            line(&mut canvas, &[(200.0, 200.0), (200.0 + 128.0*a.cos(), 200.0 + 128.0*a.sin())], 4.0, color);
+            if let Some(dot) = PathBuilder::from_circle(200.0, 200.0, 8.0) {
+                canvas.fill_path(&dot, &paint(color), FillRule::Winding, Transform::identity(), None);
+            }
+        }
+        "trend" => {
+            for i in 0..=4 {
+                let y = 205.0 + i as f32 * 32.0;
+                line(&mut canvas, &[(37.0, y), (363.0, y)], 1.0, DIM);
+            }
+            for i in 0..=5 {
+                let x = 37.0 + i as f32 * 65.2;
+                line(&mut canvas, &[(x, 205.0), (x, 333.0)], 1.0, DIM);
+            }
+            let samples: Vec<_> = history.iter().rev().take(60).copied().collect::<Vec<_>>()
+                .into_iter().rev().collect();
+            let points: Vec<_> = samples.iter().enumerate().map(|(i, value)| {
+                (363.0 - (samples.len()-1-i) as f32 * 326.0 / 59.0,
+                 333.0 - unit.ratio(*value) * 128.0)
+            }).collect();
+            if points.len() > 1 { line(&mut canvas, &points, 3.0, color); }
+            if let Some(&(x,y)) = points.last() {
+                if let Some(dot) = PathBuilder::from_circle(x,y,4.0) {
+                    canvas.fill_path(&dot, &paint(color), FillRule::Winding, Transform::identity(), None);
+                }
+            }
+        }
+        _ => bail!("Unknown sensor style: {style}"),
+    }
+    let pixels = canvas.pixels().iter().map(|p| Rgba::new(p.red(),p.green(),p.blue(),p.alpha())).collect::<Vec<_>>();
+    let mut image = Image::from_pixels(400, pixels);
+    let label: String = label.chars().take(22).collect();
+    let value = unit.value(temp);
+    let value_size = if value.len() > 5 { 62.0 } else { 82.0 };
+    match style {
+        "digital" => {
+            text(&mut image, regular, &label, 24.0, 200, 42, MUTED);
+            text(&mut image, mono, &value, value_size + 8.0, 200, 122, (240,248,255));
+            text(&mut image, regular, unit.symbol(), 28.0, 200, 233, color);
+            text(&mut image, mono, &unit.range(), 14.0, 200, 357, MUTED);
+        }
+        "classic" | "ring" => {
+            text(&mut image, regular, &label, 23.0, 200, 113, MUTED);
+            text(&mut image, mono, &value, value_size, 200, 157, (240,248,255));
+            text(&mut image, regular, unit.symbol(), 27.0, 200, 250, color);
+            text(&mut image, mono, &unit.range(), 16.0, 200, 340, MUTED);
+        }
+        "dial" => {
+            text(&mut image, regular, &label, 22.0, 200, 82, MUTED);
+            text(&mut image, mono, &unit.reading(temp), 44.0, 200, 265, (240,248,255));
+            text(&mut image, mono, "0", 16.0, 92, 309, MUTED);
+            text(&mut image, mono, &format!("{:.0}", unit.maximum()), 16.0, 308, 309, MUTED);
+        }
+        "trend" => {
+            text(&mut image, regular, &label, 24.0, 200, 34, MUTED);
+            text(&mut image, mono, &unit.reading(temp), if unit == SensorUnit::Rpm { 48.0 } else { 64.0 }, 200, 96, (240,248,255));
+            text(&mut image, regular, &format!("LAST 60 SAMPLES · {}", unit.range()), 14.0, 200, 354, color);
+        }
+        _ => unreachable!(),
+    }
+    Ok(image)
+}
