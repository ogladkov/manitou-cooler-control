@@ -0,0 +1,50 @@
+<script setup lang="ts">
+import { useId } from 'vue'
+import Button from 'primevue/button'
+import InputNumber from 'primevue/inputnumber'
+import CCColorPicker from '@/components/CCColorPicker.vue'
+import { useI18n } from 'vue-i18n'
+import { graphThresholdsValid, type GraphThresholdDraft } from '@/utils/graphThresholds'
+
+const id = useId()
+const rows = defineModel<GraphThresholdDraft[]>({ required: true })
+const props = defineProps<{ unit: string; help?: string }>()
+const { t } = useI18n()
+function setValue(index: number, value: number | null) {
+    rows.value = rows.value.map((row, i) => i === index ? { ...row, value } : row)
+}
+function setColor(index: number, color: string) {
+    const rgb = color.match(/\d+/g)?.map(Number)
+    if (!rgb || rgb.length !== 3 || rgb.some(c => c > 255)) return
+    rows.value = rows.value.map((row, i) => i === index ? { ...row, color: rgb as [number, number, number] } : row)
+}
+function add() {
+    if (rows.value.length >= 8) return
+    const step = props.unit === 'RPM' ? 500 : 10
+    let value = rows.value.length ? Math.max(...rows.value.map(r => r.value ?? 0)) + step : (props.unit === 'RPM' ? 1500 : 70)
+    while (rows.value.some(row => row.value === value)) value += step
+    rows.value = [...rows.value, { value, color: [255, 160, 40] }]
+}
+</script>
+
+<template>
+    <fieldset class="mb-6 rounded-lg border border-border-one p-3">
+        <legend class="px-1 text-text-color-secondary">{{ t('views.lcd.graphColors') }}</legend>
+        <p class="mb-3 text-sm text-text-color-secondary">{{ help ?? t('views.lcd.graphColorsHelp') }}</p>
+        <div v-for="(row, index) in rows" :key="index" class="mb-3 flex items-end gap-2">
+            <div class="min-w-0 flex-1">
+                <label :for="`${id}-graph-threshold-${index}`" class="mb-1 block text-sm">{{ t('views.lcd.graphAt') }}</label>
+                <InputNumber :input-id="`${id}-graph-threshold-${index}`" :model-value="row.value"
+                    :max-fraction-digits="2" :use-grouping="false" :suffix="` ${unit}`"
+                    class="w-full" input-class="w-full" @update:model-value="setValue(index, $event)" />
+            </div>
+            <CCColorPicker :model-value="`rgb(${row.color.join(', ')})`" :size="2.5"
+                default-color="rgb(255, 255, 255)" @update:model-value="setColor(index, $event)" />
+            <Button type="button" icon="pi pi-trash" :aria-label="t('views.lcd.graphRemove')"
+                @click="rows = rows.filter((_, i) => i !== index)" />
+        </div>
+        <p v-if="!graphThresholdsValid(rows)" role="alert" class="mb-3 text-sm text-red-400">{{ t('views.lcd.graphInvalid') }}</p>
+        <Button type="button" icon="pi pi-plus" :label="t('views.lcd.graphAdd')"
+            :disabled="rows.length >= 8" @click="add" />
+    </fieldset>
+</template>
