+    use super::single_temp_image_filename;
+
+    #[test]
+    fn independent_lcd_temperature_updates_do_not_overwrite_each_other() {
+        let root = tempfile::tempdir().unwrap();
+        let first = root.path().join(single_temp_image_filename("device-a", "lcd"));
+        let second = root.path().join(single_temp_image_filename("device-b", "lcd"));
+        let third = root.path().join(single_temp_image_filename("device-a", "lcd2"));
+        assert_ne!(first, second);
+        assert_ne!(first, third);
+        std::fs::write(&first, b"CPU temperature").unwrap();
+        std::fs::write(&second, b"GPU temperature").unwrap();
+        assert_eq!(std::fs::read(&first).unwrap(), b"CPU temperature");
+        assert_eq!(std::fs::read(&second).unwrap(), b"GPU temperature");
+        let unusual = single_temp_image_filename("../device", "../../channel");
+        assert!(!unusual.contains('/'));
+        assert_eq!(single_temp_image_filename("device-a", "lcd"), first.file_name().unwrap().to_str().unwrap());
+    }
+}
