+        let png = generator.generate_metric_image_with_thresholds(value, "", "mono_trace",
+            &history, None, SensorUnit::Celsius, &thresholds)?.0;
+        std::fs::write(output.join(format!("{name}.png")), png)?;
+    }
+    Ok(())
+}
