+use cc_image::{LcdImageGenerator, SensorUnit};
+
+fn main() -> anyhow::Result<()> {
+    let output = std::path::PathBuf::from(std::env::args().nth(1).expect("output directory"));
+    std::fs::create_dir_all(&output)?;
+    let generator = LcdImageGenerator::new();
+    let thresholds = [(70.0, (255,160,40)), (85.0, (255,64,64))];
+    for (name, value) in [("white",55.0), ("amber",75.0), ("red",90.0)] {
+        let mut history: Vec<_> = (0..60).map(|i| 28.0+i as f64*0.55+(i as f64*0.24).sin()*9.0).collect();
