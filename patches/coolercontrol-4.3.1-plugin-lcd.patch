@@ -0,0 +1,26 @@
+import type { Status } from '@/models/Status'
+
+// Typed IDs are local to LCD TempSource; they never enter the cooling profile path.
+export function lcdSensors(status: Status) {
+    const sensors: Array<{ id: string; channel: string; value: string; unit: string }> = []
+    const fresh = Date.now() - Date.parse(status.timestamp) <= 5000
+    const display = (value: number | undefined, digits: number) =>
+        fresh && value != null && Number.isFinite(value) ? value.toFixed(digits) : '--'
+    for (const temp of status.temps) {
+        sensors.push({ id: temp.name, channel: temp.name, value: display(temp.temp, 1), unit: '°C' })
+    }
+    for (const channel of status.channels) {
+        if (channel.rpm != null) {
+            sensors.push({ id: `@rpm:${channel.name}`, channel: channel.name,
+                value: display(channel.rpm, 0), unit: 'RPM' })
+        }
+        // A fan's PWM percentage is not CPU/GPU load or memory occupancy.
+        const remainingQuota = /^openai_weekly_(?:[a-f0-9]{12}_)?remaining$/.test(channel.name)
+        const diskUsage = /^disk_[a-f0-9]{12}_used$/.test(channel.name)
+        if (channel.duty != null && (channel.name.toLowerCase().includes('load') || remainingQuota || diskUsage)) {
+            sensors.push({ id: `@percent:${channel.name}`, channel: channel.name,
+                value: display(channel.duty, 1), unit: '%' })
+        }
+    }
+    return sensors
+}
