+// Each asynchronous LCD update must keep its own file until the driver has read it.
+fn single_temp_image_filename(device_uid: &str, channel_name: &str) -> String {
+    use sha2::{Digest, Sha256};
+    let mut hash = Sha256::new();
+    hash.update(device_uid.as_bytes());
+    hash.update([0]);
+    hash.update(channel_name.as_bytes());
+    format!("{}_{}", crate::hashutil::to_lower_hex(&hash.finalize()), IMAGE_FILENAME_SINGLE_TEMP)
+}
