+import { describe, it, expect, vi } from 'vitest'
+import { mount } from '@vue/test-utils'
+import PanoramaLayoutPicker from '../PanoramaLayoutPicker.vue'
+import SensorStylePicker from '../SensorStylePicker.vue'
+import { isPanoramaDisplay, panoramaStyle } from '@/utils/panorama'
+vi.mock('vue-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }))
+describe('TRYX native landscape layouts', () => {
+    it('identifies TRYX and migrates old square styles', () => {
+        expect(isPanoramaDisplay('TRYX PANORAMA 360', 2240, 1080)).toBe(true)
+        expect(isPanoramaDisplay('Lian Li UNI TL LCD', 400, 400)).toBe(false)
+        expect(isPanoramaDisplay('Other wide LCD', 2240, 1080)).toBe(false)
+        expect(panoramaStyle('mono_trace')).toBe('panorama_trace')
+        expect(panoramaStyle('mono_reverse')).toBe('panorama_scope')
+        expect(panoramaStyle(undefined)).toBe('panorama_minimal')
+    })
+    it('offers only native TRYX styles, with independent selection and landscape previews', async () => {
+        const left = mount(SensorStylePicker, { props: { modelValue: 'panorama_trace', title: 'Left', panorama: true } })
+        const right = mount(SensorStylePicker, { props: { modelValue: 'panorama_minimal', title: 'Right', panorama: true, split: true } })
+        expect(left.findAll('button')).toHaveLength(3)
+        expect(left.text()).not.toContain('Mono')
+        expect(left.find('img').attributes('style')).toContain('2240 / 1080')
+        expect(right.find('img').attributes('src')).toContain('_panel.png')
+        await left.findAll('button')[1].trigger('click')
+        expect(left.emitted('update:modelValue')).toEqual([['panorama_scope']])
+        expect(right.emitted('update:modelValue')).toBeUndefined()
+        expect(right.findAll('button')[0].attributes('aria-pressed')).toBe('true')
+    })
+    it('switches between one canvas and two independently styled halves', async () => {
+        const wrapper = mount(PanoramaLayoutPicker, { props: { modelValue: 'wide', leftStyle: 'panorama_trace', rightStyle: 'panorama_scope' } })
+        expect(wrapper.findAll('img')).toHaveLength(1)
+        await wrapper.findAll('button')[1].trigger('click')
+        expect(wrapper.emitted('update:modelValue')).toEqual([['split']])
+        await wrapper.setProps({ modelValue: 'split' })
+        expect(wrapper.findAll('img').map(i => i.attributes('src'))).toEqual(['/lcd-styles/panorama_trace_panel.png', '/lcd-styles/panorama_scope_panel.png'])
+        await wrapper.findAll('button')[0].trigger('click')
+        expect(wrapper.emitted('update:modelValue')?.at(-1)).toEqual(['wide'])
+    })
+    it('shows eight cells in plane order and emits the grid mode', async () => {
+        const styles = Array.from({length:8}, (_,i) => i%2 ? 'panorama_scope' : 'panorama_minimal')
+        const wrapper = mount(PanoramaLayoutPicker, { props: { modelValue: 'split', leftStyle: 'panorama_scope', rightStyle: 'panorama_scope', gridStyles: styles } })
+        await wrapper.findAll('button')[2].trigger('click')
+        expect(wrapper.emitted('update:modelValue')).toEqual([['grid']])
+        await wrapper.setProps({ modelValue: 'grid' })
