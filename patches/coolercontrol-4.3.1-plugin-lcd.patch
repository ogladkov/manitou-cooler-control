+import type { LcdPanelSettings, TempSource } from '@/models/DaemonSettings'
+import { graphThresholdsValid, type GraphThresholdDraft } from '@/utils/graphThresholds'
+
+export type PanoramaLayout = 'wide' | 'split' | 'grid'
+export interface PanoramaCellDraft {
+    temp_source?: TempSource
+    sensor_style: string
+    graph_thresholds: GraphThresholdDraft[]
+}
+
+export function panoramaCells(saved?: LcdPanelSettings[]): PanoramaCellDraft[] {
+    return Array.from({ length: 8 }, (_, i) => ({
+        temp_source: saved?.[i]?.temp_source ? { ...saved[i].temp_source } : undefined,
+        sensor_style: panoramaStyle(saved?.[i]?.sensor_style ?? 'panorama_scope'),
+        graph_thresholds: (saved?.[i]?.graph_thresholds ?? []).map(row => ({ ...row, color: [...row.color] })),
+    }))
+}
+
+export function serializePanoramaCells(cells: PanoramaCellDraft[]): LcdPanelSettings[] | undefined {
+    if (cells.length !== 8 || cells.some(cell => !cell.temp_source ||
+        !panoramaStyles.some(style => style.id === cell.sensor_style) || !graphThresholdsValid(cell.graph_thresholds))) return
+    return cells.map(cell => ({
+        temp_source: { ...cell.temp_source! }, sensor_style: cell.sensor_style,
+        graph_thresholds: cell.graph_thresholds.map(row => ({ value: row.value!, color: [...row.color] })),
+    }))
+}
+
+export const panoramaStyles = [
+    { id: 'panorama_minimal', label: 'Panorama Minimal' },
+    { id: 'panorama_scope', label: 'Panorama Scope' },
+    { id: 'panorama_trace', label: 'Panorama Trace' },
+]
+
+export function isPanoramaDisplay(model: string | undefined, width: number, height: number): boolean {
+    return !!model?.startsWith('TRYX PANORAMA') && width === 2240 && height === 1080
+}
+
+export function panoramaStyle(style: string | undefined): string {
+    if (style === 'mono_trace' || style === 'panorama_trace') return 'panorama_trace'
+    if (['trend', 'mono_graph', 'mono_signal', 'mono_reverse', 'panorama_scope'].includes(style ?? '')) {
+        return 'panorama_scope'
+    }
+    return 'panorama_minimal'
+}
